# Keep text checkouts consistent across Windows, macOS, and Linux.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Serialized models and media must never be line-ending converted.
*.joblib binary
*.pkl binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
