# VerdictLens local API configuration. Copy to .env only if you need overrides.
# Nothing here is required: the API runs with no configuration at all.
#
# The Gemini key is deliberately not configured on the server. The site asks the
# reviewer to paste their own key per request, and the API never stores it.

# Port for the local API (must match NEXT_PUBLIC_API_BASE_URL in the site).
VERDICTLENS_API_PORT=8000

# Where the SQLite case library is written. Defaults to backend/verdictlens.db.
# VERDICTLENS_DB=./verdictlens.db

# Optional first model tried for the Gemini wording layer.
# GEMINI_MODEL=gemini-3.1-flash-lite
